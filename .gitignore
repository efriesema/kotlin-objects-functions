# ============================================================================
# Python Virtual Environments
# ============================================================================
# Prevents committing local environments, packages, and bin tools.
.venv/
venv/
ENV/
env/
python-env/
custom-env/

# ============================================================================
# Python Bytecode & Caches
# ============================================================================
# Keeps compiled binaries and speed optimization caches out of your history.
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.cache/
.mypy_cache/
.ruff_cache/

# ============================================================================
# Environment Variables & Secrets
# ============================================================================
# NEVER commit raw passwords or secret keys. Keep local variations hidden.
.env
.env.*
!.env.example

# ============================================================================
# Distribution & Packaging
# ============================================================================
# Keeps compiled package files out of source control.
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================================
# Code Editors & IDEs (Optional but Recommended)
# ============================================================================
# JetBrains / PyCharm
.idea/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System specific files
.DS_Store
Thumbs.db

#===============================================================================
# Kotlin template
#===============================================================================


# Compiled class file
*.class

# Log file
*.log

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

### Gradle template
.gradle